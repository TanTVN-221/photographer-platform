# Prisma CLI and app development launchers read optional root .env; exports win.
# Restart pnpm dev after edits. Use literal values, not $VARIABLE expansion.
# Production start/build and the preview CLI still require process configuration.
# This example does not configure a live database or contain real credentials.
# The defaults start the web and API apps on 127.0.0.1.
API_HOST=127.0.0.1
API_PORT=4000
API_BASE_URL=http://127.0.0.1:4000
# Browser-reachable origin for application image descriptors (never a Drive URL).
# Configure both PUBLIC origins in the web runtime too for CSP/forms/images.
PUBLIC_API_BASE_URL=http://127.0.0.1:4000
PUBLIC_WEB_BASE_URL=http://127.0.0.1:3000

# Required together to enable the passwordless gallery metadata API route.
# Set these privately in your shell/secret manager; never commit real credentials.
# DATABASE_URL=postgresql://user:password@host:5432/photographer_platform
# GALLERY_CURSOR_KEY=<canonical-base64url-encoded-32-random-bytes>
# Optional protected-gallery access; use a DIFFERENT 32-byte key from the cursor key.
# Requires DATABASE_URL, GALLERY_CURSOR_KEY, PUBLIC_WEB_BASE_URL, and PUBLIC_API_BASE_URL.
# GALLERY_SESSION_KEY=<canonical-base64url-encoded-32-random-bytes>
# Optional private persistent single-instance derivative volume, with 0700 permissions.
# DERIVATIVE_STORE_ROOT=/absolute/private/path/derivatives
# Required by Prisma migration commands when using a separate direct connection.
# DIRECT_DATABASE_URL=postgresql://user:password@host:5432/photographer_platform
# For a hosted database with a provider CA, append BOTH query parameters to
# each hosted database URL (URL-encode the absolute path):
# ?sslmode=verify-full&sslrootcert=%2Fabsolute%2Fprivate%2Fpath%2Fca.pem
# Keep the provider CA local; never disable certificate/hostname verification.
# Explicit optional SQL tests: disposable loopback database only, name ends _test.
# Never use the application DATABASE_URL here. No query parameters are allowed.
# TEST_DATABASE_URL=postgresql://tester:disposable@127.0.0.1:5432/photographer_platform_test

# Optional Google photographer sign-in (identity only).
# All three are required together, with DATABASE_URL/GALLERY_CURSOR_KEY and
# the same-host public web/API origins above. AUTH_FLOW_KEY must be different
# from both gallery keys. Export these in the API process environment.
# GOOGLE_CLIENT_ID=<web-application-oauth-client-id>
# GOOGLE_CLIENT_SECRET=<web-application-oauth-client-secret>
# AUTH_FLOW_KEY=<canonical-base64url-encoded-32-random-bytes>
# Register this exact local redirect URI on that Google OAuth client:
# http://127.0.0.1:4000/api/v1/auth/google/callback

# Optional owner-authorized Google Drive connection. Requires photographer
# sign-in above, the Drive API enabled, and a fourth independent 32-byte key.
# DRIVE_TOKEN_KEY=<canonical-base64url-encoded-32-random-bytes>
# DRIVE_TOKEN_KEY_VERSION=v1
# Register this second exact redirect URI on the same Google OAuth client:
# http://127.0.0.1:4000/api/v1/drive/google/callback
